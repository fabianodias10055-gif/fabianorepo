# LocoAI Discord bot — environment template.
# Copy to .env for local development, or set these in Railway → Variables.
# Only DISCORD_BOT_TOKEN and ANTHROPIC_API_KEY are strictly required.
# NEVER commit a filled-in .env (.gitignore already excludes it).

# ── Required ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=

# ── Strongly recommended ──────────────────────────────────────────────────────
# Makes slash commands sync instantly to one guild instead of globally (~1h).
DISCORD_GUILD_ID=
# Your Discord user ID. Gates link creation, Drive access, Patreon revenue
# context and detailed error messages.
OWNER_DISCORD_ID=

# ── Channels (comma-separated IDs for KB_CHANNEL_IDS) ─────────────────────────
# Channels the bot watches and answers in without being @mentioned.
KB_CHANNEL_IDS=
PROJECTS_FORUM_CHANNEL_ID=
PATREON_ANNOUNCEMENT_CHANNEL_ID=
PATREON_PUBLIC_CHANNEL_ID=
MERCH_ALERT_CHANNEL_ID=
LINK_MANAGEMENT_CHANNEL_ID=
MIRROR_SOURCE_CHANNEL_ID=
# Mirror destination — also receives every staff/audit log.
MIRROR_DEST_CHANNEL_ID=
YOUTUBE_NOTIFY_CHANNEL_ID=
UNANSWERED_ALERT_CHANNEL_ID=

# ── AI / knowledge base ───────────────────────────────────────────────────────
KB_AI_AUTO_ANSWER=1
KB_AUTO_MIN_SCORE=3
KB_AUTO_COOLDOWN=120
KB_POST_IMAGES=
AI_USER_COOLDOWN=8
KB_SYNC_ENABLED=1
KB_SYNC_MINUTES=60
KB_DRIVE_FILE=knowledge_base.json
MAX_MESSAGES_PER_CHANNEL=250
CREATOR_ALIASES=locodev,locodevbot,loco

# ── Moderation ────────────────────────────────────────────────────────────────
SCAM_MIN_HITS=2
SCAM_NEW_ACCOUNT_DAYS=30
SCAM_ACTION=kick
SCAM_TIMEOUT_MINUTES=60
IMG_SPAM_WINDOW=60
IMG_SPAM_WARN_CHANNELS=2
IMG_SPAM_KICK_CHANNELS=3
SPAM_MSG_COUNT=6
SPAM_MSG_CHANNELS=3
SPAM_MSG_WINDOW=10
UNANSWERED_ESCALATION_MINUTES=15
UNANSWERED_PUSHOVER=

# ── Patreon ───────────────────────────────────────────────────────────────────
# FAIL-CLOSED: if this is empty the webhook returns 503 and tier-role sync stops.
PATREON_WEBHOOK_SECRET=
PATREON_ACCESS_TOKEN=

# ── Merch email watcher (needs HOST + USER + PASSWORD to enable) ──────────────
# Use a dedicated mailbox and an app-specific password, never a real login.
MERCH_EMAIL_HOST=
MERCH_EMAIL_USER=
MERCH_EMAIL_PASSWORD=
MERCH_EMAIL_PORT=993
MERCH_EMAIL_MAILBOX=INBOX
MERCH_EMAIL_POLL_SECS=300
MERCH_EMAIL_FROM_FILTER=patreon.com
MERCH_EMAIL_SUBJECT_FILTER=merch
MERCH_INFO_URL=https://locodev.dev/docs/patreonmerch

# ── Web / shortener ───────────────────────────────────────────────────────────
# Admin panel password. Empty = the admin panel is not registered at all.
ADMIN_SECRET=
# HMAC salt for visitor IP hashing. Empty = IPs are not stored.
# NEVER rotate this — it would orphan every previously stored visitor identity.
IP_HASH_SALT=

# ── Optional integrations ─────────────────────────────────────────────────────
# Full service-account JSON on a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_ROOT_FOLDER_ID=
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
YOUTUBE_API_KEY=
META_ACCESS_TOKEN=
META_PIXEL_ID=
