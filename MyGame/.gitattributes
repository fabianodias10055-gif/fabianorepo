# ============================================================================
# .gitattributes for an Unreal Engine project (Git LFS + file locking)
# ----------------------------------------------------------------------------
# Copy this file to the ROOT of your Unreal project (next to your .uproject)
# and RENAME it to exactly ".gitattributes" (with the leading dot).
#
# WHY THIS MATTERS:
#   Unreal assets (.uasset, .umap, textures, audio, models) are large BINARY
#   files. Git is built for text. Without Git LFS these files bloat the repo,
#   slow every clone, and eventually make pushes fail. LFS stores the big
#   binaries on a side server and keeps only small pointers in git history.
#
#   The "lockable" flag lets a teammate LOCK a binary file while they edit it,
#   so two people cannot silently overwrite each other's work on a file that
#   git physically cannot merge. See SETUP_GUIDE.md for the locking workflow.
# ============================================================================

# Normalize line endings for text files, auto-detect what is text.
* text=auto

# --- Unreal native asset types (LFS + lockable) -----------------------------
*.uasset  filter=lfs diff=lfs merge=lfs -text lockable
*.umap    filter=lfs diff=lfs merge=lfs -text lockable
*.upk     filter=lfs diff=lfs merge=lfs -text lockable
*.udk     filter=lfs diff=lfs merge=lfs -text lockable

# --- 3D models --------------------------------------------------------------
*.fbx     filter=lfs diff=lfs merge=lfs -text lockable
*.obj     filter=lfs diff=lfs merge=lfs -text lockable
*.3ds     filter=lfs diff=lfs merge=lfs -text lockable
*.blend   filter=lfs diff=lfs merge=lfs -text lockable

# --- Textures / images ------------------------------------------------------
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.bmp     filter=lfs diff=lfs merge=lfs -text
*.tiff    filter=lfs diff=lfs merge=lfs -text
*.tif     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text lockable

# --- Audio ------------------------------------------------------------------
*.wav     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.flac    filter=lfs diff=lfs merge=lfs -text

# --- Video ------------------------------------------------------------------
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.mov     filter=lfs diff=lfs merge=lfs -text
*.avi     filter=lfs diff=lfs merge=lfs -text

# --- Fonts ------------------------------------------------------------------
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text

# --- Other large binaries ---------------------------------------------------
*.bin     filter=lfs diff=lfs merge=lfs -text
*.pak     filter=lfs diff=lfs merge=lfs -text
*.zip     filter=lfs diff=lfs merge=lfs -text
