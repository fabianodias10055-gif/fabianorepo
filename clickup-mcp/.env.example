# Copie este arquivo para .env e preencha. O .env já está no .gitignore
# da raiz do repositório - nunca comite o token.
#
# Onde pegar o token:
#   ClickUp > sua foto (canto inferior esquerdo) > Settings > Apps > API Token
# Ele começa com pk_ e dá acesso TOTAL à sua conta, sem escopo. Trate como senha.
#
# Alternativa mais segura ao .env: guardar no cofre do sistema (Windows
# Credential Manager) e deixar esta linha vazia:
#   pip install keyring
#   python -m keyring set clickup-mcp api_token

CLICKUP_API_TOKEN=pk_cole_seu_token_aqui

# Teto local de requisições por minuto. A API do ClickUp permite 100/min nos
# planos Free, Unlimited e Business. O padrão 80 deixa folga caso o mesmo token
# esteja em uso por outra automação (Zapier, Make, outro script).
CLICKUP_MAX_RPM=80

# Habilita a ferramenta apagar_tarefa. Desligada por padrão porque a exclusão
# é irreversível e a API do ClickUp não tem lixeira.
CLICKUP_ALLOW_DELETE=false

# Modo simulação global do servidor MCP: toda ferramenta de escrita apenas
# descreve o que faria, sem executar. Bom para planejar mudanças grandes.
CLICKUP_DRY_RUN=false

# Tempo de vida (segundos) do cache de leituras estáveis (hierarquia, membros).
CLICKUP_CACHE_TTL=300

# Teto do download em anexar_url, em megabytes.
CLICKUP_MAX_DOWNLOAD_MB=50

# Sync automático do vault: após qualquer escrita feita pelo servidor MCP, os
# espelhos do vault ClickUp Sync são atualizados em segundo plano (~15s).
# Ponha false para desligar e ficar só com a tarefa agendada de hora em hora.
CLICKUP_AUTO_SYNC=true

# --- Integrações opcionais (as ferramentas ficam desativadas sem isto) ---

# Resend (enviar_email_resend): chave em https://resend.com/api-keys
# RESEND_FROM precisa ser de um domínio verificado na sua conta Resend.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO_DEFAULT=

# Discord (notificar_discord): webhook do canal em
# Configurações do canal > Integrações > Webhooks
DISCORD_WEBHOOK_URL=

# --- LocoDev Operations Panel (panel.py, collect_youtube.py) ---

# Le comentarios publicos do YouTube. So precisa de API key simples (sem
# OAuth). console.cloud.google.com > APIs & Services > Credentials >
# Create Credentials > API key > restrinja a "YouTube Data API v3".
YOUTUBE_API_KEY=

# Postar resposta de verdade no YouTube via o botao Reply do painel. Exige
# OAuth (nao a API key acima) porque e uma escrita na sua conta. Preenchido
# automaticamente por youtube_oauth_setup.py; nao editar a mao.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Secao "Link telemetry" do painel: le a API admin do encurtador em
# locodev.dev/adminlocoILco, servidor-a-servidor (o navegador nunca ve o
# segredo nem o token). O valor e o mesmo ADMIN_SECRET configurado nas
# variaveis do servico do bot no Railway. Vazio = a secao diz "not
# configured" em vez de fingir dados.
LOCODEV_ADMIN_URL=https://locodev.dev/adminlocoILco
LOCODEV_ADMIN_SECRET=

# Botao "Ask Claude" do painel: roda o Claude Code CLI em modo headless para
# ler o vault e rascunhar a resposta. Usa a sua sessao ja logada do CLI (nao
# precisa de API key). O rascunho NUNCA e enviado sozinho: cai na caixa de
# resposta para voce revisar.
# effort: low | medium | high | xhigh | max  (mais alto = melhor e mais lento)
# Cada chamada custa da ordem de US$ 0,50 a 1,00 e leva ~90s com opus/xhigh.
PANEL_AI_MODEL=opus
PANEL_AI_EFFORT=xhigh
PANEL_AI_BUDGET_USD=1.50
PANEL_AI_TIMEOUT=300
# Caminho do executavel do CLI, se ele nao estiver no PATH do watcher.
PANEL_CLAUDE_BIN=
